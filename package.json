{
  "name": "web-cctv-hg680p",
  "version": "3.1.4",
  "description": "Web CCTV ringan untuk STB Armbian HG680P - H.265 to H.264 HLS, Recording Scheduler, Retention Policy, Notifikasi Telegram, Audit Log, 2FA TOTP, Deteksi Objek AI, SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:mysql": "node server.mysql.js",
    "dev": "nodemon server.js",
    "init-db": "node init-db.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/vendor/tailwind.css --minify"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "hls.js": "^1.7.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.16"
  },
  "engines": {
    "node": ">=20"
  }
}
